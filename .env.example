# ---- Server ----
NODE_ENV=development
PORT=3000
# Public URL of the site (used for CORS / cookie decisions). No trailing slash.
APP_URL=http://localhost:3000
# Expo mobile WebView URL; set this to the computer's LAN IP if Expo cannot detect it.
# EXPO_PUBLIC_SERVER_URL=http://<computer-LAN-IP>:3000
# Must be 1 on Render, Railway, Fly, nginx, or any load balancer.
TRUST_PROXY=0

# ---- Security (REQUIRED in production) ----
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-in-production-change-me-in-production
OTP_PEPPER=change-me-too-change-me-too
JWT_EXPIRES_IN_DAYS=7

# ---- PostgreSQL ----
# Create the database first, then use its PostgreSQL connection URL.
DATABASE_URL=postgresql://postgres:password@localhost:5432/agriconnect
DATABASE_SSL=false
DATABASE_SSL_VERIFY=true
DATABASE_POOL_SIZE=10
# Existing SQLite file imported once by `npm run migrate:postgres`.
SQLITE_SOURCE_PATH=./data/agriconnect.db

# ---- File storage ----
UPLOAD_DIR=./uploads
MAX_IMAGES_PER_LISTING=6
MAX_IMAGE_MB=5

# ---- OTP ----
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30
# Max OTP requests per phone per hour
OTP_MAX_PER_HOUR=6
DEFAULT_COUNTRY_CODE=+91

# ---- SMS provider: console | twilio | msg91 ----
# "console" prints the OTP in the server log (development only, refused in production).
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
# Optional approved MSG91 Flow template for booking/message alerts (must contain VAR1 and VAR2).
MSG91_NOTIFICATION_TEMPLATE_ID=

# ---- Admin account (created / updated on startup) ----
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeThisAdminPassword!1

# ---- Separate database manager login (/database-manager) ----
# Change these before deployment. Use a unique password of at least 16 characters.
DB_MANAGER_EMAIL=dbadmin@example.com
DB_MANAGER_PASSWORD=replace-with-a-unique-password-of-at-least-16-chars

# ---- Map tiles (no API key required) ----
# OpenStreetMap street map and Esri World Imagery satellite map.
MAP_STREET_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_STREET_ATTRIBUTION=&copy; OpenStreetMap contributors
MAP_SAT_TILE_URL=https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}
MAP_SAT_ATTRIBUTION=Imagery &copy; Esri, Maxar, Earthstar Geographics

# ---- Marketplace behaviour ----
# true = new listings stay "pending" until an admin approves them
LISTINGS_REQUIRE_APPROVAL=true
